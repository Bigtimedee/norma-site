# X / Twitter API v2 credentials
# https://developer.twitter.com/en/portal/dashboard
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_TOKEN_SECRET=
TWITTER_BEARER_TOKEN=

# Anthropic — used to generate tweet text
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# The Odds API — live sports odds
# https://the-odds-api.com (free tier: 500 requests/month)
ODDS_API_KEY=

# Optional: comma-separated sport keys to include
# Defaults to NFL, NBA, MLB, NHL
# NORMA_SPORT=americanfootball_nfl,basketball_nba,baseball_mlb,icehockey_nhl
