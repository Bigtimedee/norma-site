# X / Twitter API v2 credentials
# https://developer.twitter.com/en/portal/dashboard
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_TOKEN_SECRET=
TWITTER_BEARER_TOKEN=

# Anthropic — used to generate tweet text
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# The Odds API — live sports odds
# https://the-odds-api.com (free tier: 500 requests/month)
ODDS_API_KEY=

# Optional: comma-separated sport keys to include
# Defaults to NFL, NBA, MLB, NHL
# NORMA_SPORT=americanfootball_nfl,basketball_nba,baseball_mlb,icehockey_nhl


# ── ProphetX (read-only market data) ────────────────────────────────────────
# Request access first: docs/prophetx/API-ACCESS-REQUEST.md
# SERVER-SIDE ONLY. This is a static header key — a key shipped in a mobile
# binary is a leaked key.
PROPHETX_API_KEY=

# Base URL. Unset defaults to the documented sandbox:
#   https://api-ss-sandbox.betprophet.co/partner
# ProphetX does not publish a production host, so going live is deliberately
# explicit rather than guessed. See question 2 in docs/prophetx/OPEN-QUESTIONS.md.
# PROPHETX_BASE_URL=

# Remote availability config, so ProphetX can be enabled or disabled per
# jurisdiction without shipping an app release. Unset means ProphetX stays off
# (the gate fails closed). Sample: docs/prophetx/availability.sample.json
# PROPHETX_CONFIG_URL=
